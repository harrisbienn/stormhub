{
  "$defs": {
    "AntecedentConditions": {
      "additionalProperties": false,
      "description": "Optional hydrologic state applied before the precipitation event.",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "condition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Condition Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/StacAssetReference"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "condition_id",
        "as_of"
      ],
      "title": "AntecedentConditions",
      "type": "object"
    },
    "ExecutionSpec": {
      "additionalProperties": false,
      "description": "Runner configuration that can affect a model stage's results.",
      "properties": {
        "command": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "runner": {
          "minLength": 1,
          "title": "Runner",
          "type": "string"
        },
        "software": {
          "$ref": "#/$defs/SoftwareProvenance"
        }
      },
      "required": [
        "runner",
        "software"
      ],
      "title": "ExecutionSpec",
      "type": "object"
    },
    "FailureDetails": {
      "additionalProperties": false,
      "description": "Machine-readable failure information for retry decisions.",
      "properties": {
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "error_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Error Type",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "error_type",
        "message"
      ],
      "title": "FailureDetails",
      "type": "object"
    },
    "FileReference": {
      "additionalProperties": false,
      "description": "Content-addressed reference to a run input or output file.",
      "properties": {
        "asset_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Asset Key",
          "type": "string"
        },
        "href": {
          "minLength": 1,
          "title": "Href",
          "type": "string"
        },
        "kind": {
          "const": "file",
          "default": "file",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "roles": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "asset_key",
        "href",
        "media_type",
        "roles",
        "sha256",
        "size_bytes"
      ],
      "title": "FileReference",
      "type": "object"
    },
    "HydraulicModel": {
      "additionalProperties": false,
      "description": "Versioned hydraulic model package and selected plan.",
      "properties": {
        "engine": {
          "default": "HEC-RAS",
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "engine_version": {
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/FileReference"
        },
        "plan_name": {
          "minLength": 1,
          "title": "Plan Name",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "engine_version",
        "plan_name",
        "package"
      ],
      "title": "HydraulicModel",
      "type": "object"
    },
    "HydraulicStageSpec": {
      "additionalProperties": false,
      "description": "Result-defining RAS model, execution, and upstream mappings.",
      "properties": {
        "boundary_mappings": {
          "items": {
            "$ref": "#/$defs/HydrologicBoundaryMapping"
          },
          "title": "Boundary Mappings",
          "type": "array"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionSpec"
        },
        "model": {
          "$ref": "#/$defs/HydraulicModel"
        }
      },
      "required": [
        "model",
        "execution"
      ],
      "title": "HydraulicStageSpec",
      "type": "object"
    },
    "HydrologicBoundaryMapping": {
      "additionalProperties": false,
      "description": "Explicit link from one HMS result pathname to one RAS boundary.",
      "properties": {
        "hms_dss_pathname": {
          "minLength": 1,
          "title": "Hms Dss Pathname",
          "type": "string"
        },
        "hms_element": {
          "minLength": 1,
          "title": "Hms Element",
          "type": "string"
        },
        "hms_parameter": {
          "default": "FLOW",
          "minLength": 1,
          "title": "Hms Parameter",
          "type": "string"
        },
        "interval_minutes": {
          "exclusiveMinimum": 0,
          "title": "Interval Minutes",
          "type": "integer"
        },
        "mapping_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Mapping Id",
          "type": "string"
        },
        "ras_boundary_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Ras Boundary Id",
          "type": "string"
        },
        "ras_boundary_type": {
          "minLength": 1,
          "title": "Ras Boundary Type",
          "type": "string"
        },
        "ras_location": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "title": "Ras Location",
          "type": "object"
        },
        "units": {
          "minLength": 1,
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "mapping_id",
        "hms_element",
        "hms_dss_pathname",
        "ras_boundary_id",
        "ras_boundary_type",
        "ras_location",
        "units",
        "interval_minutes"
      ],
      "title": "HydrologicBoundaryMapping",
      "type": "object"
    },
    "HydrologicModel": {
      "additionalProperties": false,
      "description": "Versioned hydrologic model package and selected HMS run.",
      "properties": {
        "engine": {
          "default": "HEC-HMS",
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "engine_version": {
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/FileReference"
        },
        "run_name": {
          "minLength": 1,
          "title": "Run Name",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "engine_version",
        "run_name",
        "package"
      ],
      "title": "HydrologicModel",
      "type": "object"
    },
    "HydrologicStageSpec": {
      "additionalProperties": false,
      "description": "Result-defining HMS model and execution configuration.",
      "properties": {
        "execution": {
          "$ref": "#/$defs/ExecutionSpec"
        },
        "model": {
          "$ref": "#/$defs/HydrologicModel"
        }
      },
      "required": [
        "model",
        "execution"
      ],
      "title": "HydrologicStageSpec",
      "type": "object"
    },
    "PrecipitationInput": {
      "additionalProperties": false,
      "description": "Source and watershed-transposed precipitation for the run.",
      "properties": {
        "duration_hours": {
          "exclusiveMinimum": 0,
          "title": "Duration Hours",
          "type": "integer"
        },
        "event_end": {
          "format": "date-time",
          "title": "Event End",
          "type": "string"
        },
        "event_start": {
          "format": "date-time",
          "title": "Event Start",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "source_aorc": {
          "$ref": "#/$defs/StacAssetReference"
        },
        "transposed_dss": {
          "$ref": "#/$defs/StacAssetReference"
        }
      },
      "required": [
        "source_aorc",
        "transposed_dss",
        "event_start",
        "event_end",
        "duration_hours"
      ],
      "title": "PrecipitationInput",
      "type": "object"
    },
    "PublicationDisposition": {
      "description": "Approved use of a cataloged scenario response.",
      "enum": [
        "prohibited",
        "internal",
        "candidate",
        "eligible",
        "retired"
      ],
      "title": "PublicationDisposition",
      "type": "string"
    },
    "QualificationGate": {
      "additionalProperties": false,
      "description": "One independently reviewable integrated qualification decision.",
      "properties": {
        "evidence_asset_keys": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Evidence Asset Keys",
          "type": "array"
        },
        "message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/QualificationStatus",
          "default": "not_evaluated"
        }
      },
      "title": "QualificationGate",
      "type": "object"
    },
    "QualificationStatus": {
      "description": "Decision state for one integrated qualification gate.",
      "enum": [
        "not_evaluated",
        "pass",
        "conditional",
        "fail",
        "not_applicable"
      ],
      "title": "QualificationStatus",
      "type": "string"
    },
    "QualificationSummary": {
      "additionalProperties": false,
      "description": "Four gates that separate execution completion from model qualification.",
      "properties": {
        "hms_execution": {
          "$ref": "#/$defs/QualificationGate"
        },
        "hydraulic_qaqc": {
          "$ref": "#/$defs/QualificationGate"
        },
        "hydrologic_handoff": {
          "$ref": "#/$defs/QualificationGate"
        },
        "ras_execution": {
          "$ref": "#/$defs/QualificationGate"
        }
      },
      "title": "QualificationSummary",
      "type": "object"
    },
    "QualityCheck": {
      "additionalProperties": false,
      "description": "One named validation performed on inputs, execution, or outputs.",
      "properties": {
        "message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QualityStatus"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "QualityCheck",
      "type": "object"
    },
    "QualityStatus": {
      "description": "Aggregate or individual quality-control result.",
      "enum": [
        "not_run",
        "passed",
        "warning",
        "failed"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "QualitySummary": {
      "additionalProperties": false,
      "description": "Aggregate quality state and its supporting checks.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/QualityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/QualityStatus",
          "default": "not_run"
        }
      },
      "title": "QualitySummary",
      "type": "object"
    },
    "RunStatus": {
      "description": "Lifecycle states for an integrated run or one model stage.",
      "enum": [
        "planned",
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ScenarioRunSpec": {
      "additionalProperties": false,
      "description": "Immutable inputs for one hydraulic-only or HMS-to-RAS execution.",
      "properties": {
        "antecedent_conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/AntecedentConditions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hydraulic": {
          "$ref": "#/$defs/HydraulicStageSpec"
        },
        "hydrologic": {
          "anyOf": [
            {
              "$ref": "#/$defs/HydrologicStageSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "precipitation": {
          "$ref": "#/$defs/PrecipitationInput"
        },
        "watershed": {
          "$ref": "#/$defs/WatershedReference"
        },
        "workflow": {
          "$ref": "#/$defs/WorkflowKind"
        }
      },
      "required": [
        "workflow",
        "watershed",
        "precipitation",
        "hydraulic"
      ],
      "title": "ScenarioRunSpec",
      "type": "object"
    },
    "SoftwareProvenance": {
      "additionalProperties": false,
      "description": "Code and runtime identity used to execute a scenario.",
      "properties": {
        "container_digest": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "container_image": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Image"
        },
        "dirty": {
          "default": false,
          "title": "Dirty",
          "type": "boolean"
        },
        "operating_system": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating System"
        },
        "python_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Version"
        },
        "repository": {
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision"
      ],
      "title": "SoftwareProvenance",
      "type": "object"
    },
    "StacAssetReference": {
      "additionalProperties": false,
      "description": "Stable reference to one asset on one STAC Item.",
      "properties": {
        "asset_href": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Href"
        },
        "asset_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Asset Key",
          "type": "string"
        },
        "collection_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Collection Id",
          "type": "string"
        },
        "item_href": {
          "minLength": 1,
          "title": "Item Href",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "const": "stac_asset",
          "default": "stac_asset",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "item_href",
        "collection_id",
        "item_id",
        "asset_key"
      ],
      "title": "StacAssetReference",
      "type": "object"
    },
    "StageName": {
      "description": "Stable names for model stages recorded in run provenance.",
      "enum": [
        "hydrologic",
        "hydraulic"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageRun": {
      "additionalProperties": false,
      "description": "Lifecycle and output references for one model stage.",
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_asset_keys": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Output Asset Keys",
          "type": "array"
        },
        "quality": {
          "$ref": "#/$defs/QualitySummary"
        },
        "stage": {
          "$ref": "#/$defs/StageName"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "StageRun",
      "type": "object"
    },
    "WatershedReference": {
      "additionalProperties": false,
      "description": "Target watershed used by both precipitation and hydraulic processing.",
      "properties": {
        "geometry_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Geometry Sha256",
          "type": "string"
        },
        "item_href": {
          "minLength": 1,
          "title": "Item Href",
          "type": "string"
        },
        "watershed_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Watershed Id",
          "type": "string"
        }
      },
      "required": [
        "watershed_id",
        "item_href",
        "geometry_sha256"
      ],
      "title": "WatershedReference",
      "type": "object"
    },
    "WorkflowKind": {
      "description": "Supported model-stage topologies.",
      "enum": [
        "hydrologic_hydraulic",
        "hydraulic_only"
      ],
      "title": "WorkflowKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned manifest for one planned or completed scenario run.",
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "contract_version": {
      "default": "2.1.0",
      "enum": [
        "2.0.0",
        "2.1.0"
      ],
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureDetails"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/FileReference"
      },
      "title": "Outputs",
      "type": "array"
    },
    "publication": {
      "$ref": "#/$defs/PublicationDisposition",
      "default": "prohibited"
    },
    "qualification": {
      "$ref": "#/$defs/QualificationSummary"
    },
    "quality": {
      "$ref": "#/$defs/QualitySummary"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/ScenarioRunSpec"
    },
    "specification_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Specification Sha256",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRun"
      },
      "title": "Stages",
      "type": "array"
    },
